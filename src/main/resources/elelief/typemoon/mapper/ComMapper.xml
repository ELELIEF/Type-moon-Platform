<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="elelief.typemoon.mapper.ComMapper">
    <select id="findAll" resultType="elelief.typemoon.pojo.BasicCom">
        select com_id,com_name,com_img,com_backimg from tb_message
    </select>
    <delete id="deleteById" parameterType="int">
        delete from tb_message where com_id=#{id}
    </delete>
    <insert id="Insert">
        insert into tb_message(com_name,com_type,com_theme,com_date,com_story) values(#{comName},#{comType},#{comTheme},#{comDate},#{comStory})
    </insert>
    <select id="findById" parameterType="int" resultType="elelief.typemoon.pojo.CompositionMessage">
        select *from tb_message where com_id=#{id}
    </select>


</mapper>