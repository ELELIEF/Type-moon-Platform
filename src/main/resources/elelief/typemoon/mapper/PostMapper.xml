<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="elelief.typemoon.mapper.PostMapper">
    <select id="getPosts" resultType="elelief.typemoon.pojo.Post">
        select post_id,post_title,post_author,post_commentnum from tb_posts;
    </select>
    <!-- 定义评论的ResultMap -->
    <resultMap id="CommentResultMap" type="elelief.typemoon.pojo.Comment">
        <id column="comment_id" property="commentId"/>  <!-- 评论主键，必须有 -->
        <result column="comment_text" property="commentText"/>  <!-- 评论内容 -->
        <result column="comment_author" property="commentAuthor"/>  <!-- 新增：评论作者 -->
        <result column="comment_createdtime" property="commentCreatedtime"/>  <!-- 新增：评论时间 -->
        <result column="comment_updatedtime" property="commentUpdatedtime"/>  <!-- 新增：评论更新时间 -->
        <result column="post_id" property="postId"/>  <!-- 关联的帖子ID -->
    </resultMap>

    <!-- 定义帖子的ResultMap，包含评论集合 -->
    <resultMap id="PostWithCommentsResultMap" type="elelief.typemoon.pojo.Post" extends="PostbasicMessage">

        <collection property="comments"
                    ofType="elelief.typemoon.pojo.Comment"
                    resultMap="CommentResultMap"
                    notNullColumn="comment_id">
        </collection>
    </resultMap>
    <resultMap id="PostbasicMessage" type="elelief.typemoon.pojo.Post">
        <id column="post_id" property="postId"/>
        <result column="post_title" property="postTitle"/>
        <result column="post_content" property="postContent"/>
        <result column="post_author" property="postAuthor"/>
        <result column="post_status" property="postStatus"/>
        <result column="post_createdtime" property="postCreatedtime"/>
        <result column="post_updatedtime" property="postUpdatedtime"/>
        <result column="post_commentnum" property="postCommentnum"/>

    </resultMap>

    <!-- 关联查询SQL -->
    <select id="getPostDetail" resultMap="PostWithCommentsResultMap">
        SELECT
            -- 1. 补充PostbasicMessage中配置的所有帖子字段
            p.post_id,
            p.post_title,
            p.post_content,
            p.post_author,       -- 新增：对应postAuthor属性
            p.post_status,       -- 新增：对应postStatus属性
            p.post_createdtime,  -- 新增：对应postCreatedtime属性
            p.post_updatedtime,  -- 新增：对应postUpdatedtime属性
            p.post_commentnum,   -- 新增：对应postCommentnum属性
            -- 2. 评论字段（原配置不变）
            c.comment_id AS comment_id,        -- 评论主键
            c.comment_text AS comment_text,    -- 评论内容
            c.comment_author AS comment_author,-- 评论作者（新增）
            c.comment_createdtime AS comment_createdtime,-- 评论时间（新增）
            c.comment_updatedtime AS comment_updatedtime,-- 评论更新时间（新增）
            c.post_id AS post_id               -- 关联的帖子ID
        FROM tb_posts p
                 -- 关键：过滤未删除的评论（is_deleted=1可能是未删除，根据业务确认）
                 LEFT JOIN tb_comments c ON p.post_id = c.post_id AND c.is_deleted = 1 AND c.parent_id='0'
        WHERE p.post_id = #{postId}
    </select>
    <insert id="submitPost">
        insert into tb_posts(post_title, post_content, post_author, post_status, post_createdtime, post_updatedtime) values(#{postTitle},#{postContent},#{postAuthor},#{postStatus},#{postCreatedtime},#{postUpdatedtime})
    </insert>


</mapper>